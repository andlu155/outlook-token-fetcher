{
  "manifest_version": 3,
  "name": "Outlook Token Fetcher",
  "version": "1.27",
  "description": "半自动获取 Outlook 账号 OAuth2 刷新令牌 — HTTP/SOCKS5 代理与测速；备用邮箱最多100；结果持久化；异常关闭自动暂停可继续；密码/限流/锁定/人机跳过；取码单飞；结果排序导出",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "sidePanel",
    "browsingData",
    "cookies",
    "webNavigation",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "*://login.microsoftonline.com/*",
    "*://login.live.com/*",
    "*://account.live.com/*",
    "*://*.microsoft.com/*",
    "*://*.live.com/*",
    "https://*/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Outlook Token Fetcher"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "incognito": "split",
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://login.microsoftonline.com/*",
        "*://login.live.com/*",
        "*://account.live.com/*",
        "*://*.microsoft.com/*",
        "*://*.live.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
